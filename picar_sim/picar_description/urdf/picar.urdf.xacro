<?xml version="1.0"?>
<!--
  Adeept PiCar-B (Mars Rover) twin for Gazebo Harmonic + ROS 2 Jazzy.

  Rear-wheel drive (one motor), front Ackermann steering servo,
  pan/tilt camera head, forward-facing ultrasonic sensor.

  Frames: base_footprint (ground, under the rear axle) -> base_link (rear axle centre).
  Joint signs: head pan + = left, head tilt + = up, steering + = left.

  TODO: the dimensions in the first block are estimates. Measure your car and
  update them so the twin turns and stops like the real one.
-->
<robot name="picar" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== Dimensions (metres, radians). TODO: measure the real car ===== -->
  <xacro:property name="wheel_radius"     value="0.0325"/>  <!-- 65 mm wheels -->
  <xacro:property name="wheel_width"      value="0.026"/>
  <xacro:property name="wheel_base"       value="0.145"/>   <!-- rear axle to front axle -->
  <xacro:property name="wheel_separation" value="0.135"/>   <!-- left to right wheel centres -->
  <xacro:property name="kingpin_width"    value="0.110"/>   <!-- left to right steering pivots -->
  <xacro:property name="steering_limit"   value="0.60"/>    <!-- ~34 deg, servo end stops -->
  <xacro:property name="chassis_length"   value="0.220"/>
  <xacro:property name="chassis_width"    value="0.100"/>
  <xacro:property name="chassis_height"   value="0.040"/>
  <xacro:property name="head_x"           value="0.150"/>   <!-- pan axis, forward of rear axle -->
  <xacro:property name="mast_height"      value="0.070"/>   <!-- chassis top to pan joint -->

  <!-- ===== Masses (kg) ===== -->
  <xacro:property name="chassis_mass" value="0.90"/>
  <xacro:property name="wheel_mass"   value="0.04"/>

  <!-- ===== Materials ===== -->
  <material name="chassis_green"><color rgba="0.20 0.45 0.25 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="grey"><color rgba="0.55 0.55 0.55 1"/></material>
  <material name="sensor_blue"><color rgba="0.15 0.35 0.80 1"/></material>

  <!-- ===== Inertia helpers ===== -->
  <xacro:macro name="box_inertial" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- A wheel spinning about its local y axis -->
  <xacro:macro name="wheel" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertial m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertial>
    </link>
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <!-- ===== Body ===== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="${wheel_base/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_green"/>
    </visual>
    <collision>
      <origin xyz="${wheel_base/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <!-- camera mast -->
    <visual>
      <origin xyz="${head_x} 0 ${chassis_height + mast_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.006" length="${mast_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <xacro:box_inertial m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="${wheel_base/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===== Rear wheels (driven) ===== -->
  <xacro:wheel name="rear_left_wheel"/>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0 ${wheel_separation/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel name="rear_right_wheel"/>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 ${-wheel_separation/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===== Front steering + free-spinning front wheels ===== -->
  <xacro:macro name="front_corner" params="side y_sign">
    <link name="front_${side}_steer_link">
      <xacro:box_inertial m="0.02" x="0.02" y="0.02" z="0.02">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>
    <joint name="front_${side}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_steer_link"/>
      <origin xyz="${wheel_base} ${y_sign*kingpin_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steering_limit}" upper="${steering_limit}" effort="5.0" velocity="6.0"/>
    </joint>

    <xacro:wheel name="front_${side}_wheel"/>
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_steer_link"/>
      <child link="front_${side}_wheel"/>
      <origin xyz="0 ${y_sign*(wheel_separation - kingpin_width)/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:front_corner side="left" y_sign="1"/>
  <xacro:front_corner side="right" y_sign="-1"/>

  <!-- ===== Pan/tilt camera head ===== -->
  <link name="head_pan_link">
    <visual>
      <origin xyz="0 0 0.0075" rpy="0 0 0"/>
      <geometry><box size="0.030 0.040 0.015"/></geometry>
      <material name="grey"/>
    </visual>
    <xacro:box_inertial m="0.03" x="0.030" y="0.040" z="0.015">
      <origin xyz="0 0 0.0075" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>
  <joint name="head_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="head_pan_link"/>
    <origin xyz="${head_x} 0 ${chassis_height + mast_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="1.0" velocity="3.0"/>
  </joint>

  <link name="head_tilt_link">
    <visual>
      <geometry><box size="0.020 0.050 0.030"/></geometry>
      <material name="black"/>
    </visual>
    <xacro:box_inertial m="0.03" x="0.020" y="0.050" z="0.030">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>
  <!-- axis -y so that a positive angle tilts the camera up -->
  <joint name="head_tilt_joint" type="revolute">
    <parent link="head_pan_link"/>
    <child link="head_tilt_link"/>
    <origin xyz="0 0 0.030" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.7" upper="0.7" effort="1.0" velocity="3.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0.003 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.006" length="0.006"/></geometry>
      <material name="sensor_blue"/>
    </visual>
    <xacro:box_inertial m="0.005" x="0.01" y="0.01" z="0.01">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="head_tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0.012 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ROS optical frame: z forward, x right, y down -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ===== Ultrasonic sensor (front of chassis, facing forward) ===== -->
  <link name="ultrasonic_link">
    <visual>
      <geometry><box size="0.012 0.045 0.020"/></geometry>
      <material name="sensor_blue"/>
    </visual>
    <xacro:box_inertial m="0.01" x="0.012" y="0.045" z="0.020">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>
  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
    <origin xyz="${wheel_base/2 + chassis_length/2 + 0.006} 0 ${chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Gazebo sensors ===================== -->

  <!-- Pi camera: about 62 deg horizontal field of view -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.085</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.03</near>
          <far>20</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!--
    Ultrasonic stand-in: Gazebo has no sonar, so a narrow lidar fan (about 15 deg,
    like an HC-SR04) is used. ros_gz_bridge turns this LaserScan into a
    sensor_msgs/Range holding the shortest ray. Rays are kept level so they
    don't hit the floor.
  -->
  <gazebo reference="ultrasonic_link">
    <sensor name="ultrasonic" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/ultrasonic/range</topic>
      <gz_frame_id>ultrasonic_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>15</samples>
            <resolution>1</resolution>
            <min_angle>-0.26</min_angle>
            <max_angle>0.26</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== Gazebo controllers ===================== -->
  <gazebo>
    <!-- Rear-drive Ackermann: takes Twist (m/s, rad/s yaw rate) on /sim/cmd_vel -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>${kingpin_width}</kingpin_width>
      <steering_limit>${steering_limit}</steering_limit>
      <wheel_base>${wheel_base}</wheel_base>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <steer_p_gain>8.0</steer_p_gain>
      <min_velocity>-0.8</min_velocity>
      <max_velocity>0.8</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
      <topic>/sim/cmd_vel</topic>
      <odom_topic>/sim/odom</odom_topic>
      <tf_topic>/sim/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

      <!-- Head servos: target angle in radians (std_msgs/Float64).
        Torque (PID) control: with velocity commands a joint that reaches its
        limit stays stuck there. -->
        <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
        <joint_name>head_pan_joint</joint_name>
        <topic>/sim/head_pan</topic>
        <p_gain>0.1</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.003</d_gain>
        <cmd_max>0.05</cmd_max>
        <cmd_min>-0.05</cmd_min>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>head_tilt_joint</joint_name>
      <topic>/sim/head_tilt</topic>
      <p_gain>0.1</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.002</d_gain>
      <cmd_max>0.05</cmd_max>
      <cmd_min>-0.05</cmd_min>
    </plugin>
    <!-- Joint angles for robot_state_publisher / RViz -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/sim/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
