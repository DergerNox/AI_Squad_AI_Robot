# Copy this file to .env and fill it in. Never share or commit .env: it holds your keys.

# Which AI drives the car:
#   ollama  a local model in Ollama (the default)
#   openai  OpenAI, or any server with an OpenAI-compatible API
#   google  Gemini
PICAR_LLM=ollama

# The model. It must understand pictures and support tool calling.
# Empty = qwen3-vl:4b-instruct for ollama; required for openai and google.
PICAR_MODEL=

# The server address, if it is not the default one. Examples:
#   http://192.168.1.20:11434      Ollama on another computer
#   https://your-server.example/v1 an OpenAI-compatible server
PICAR_BASE_URL=

# Keys for the cloud models
OPENAI_API_KEY=
GOOGLE_API_KEY=
