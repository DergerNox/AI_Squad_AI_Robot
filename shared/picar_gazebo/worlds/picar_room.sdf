<?xml version="1.0" ?>
<!--
  3 m x 3 m room for the PiCar-B twin: four low walls and three coloured
  obstacles for camera and ultrasonic tests. The car spawns at the origin
  facing +x, with the red box about 0.7 m in front of the ultrasonic sensor.
-->
<sdf version="1.9">
  <world name="picar_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.5 0.3 -0.8</direction>
    </light>
        
    <!-- Ceiling lamp over the middle of the room: lights the sides of the
          objects that face into the room, like indoor light does. -->
    <light type="point" name="ceiling_lamp">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 1.2 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>6</range>
        <constant>0.4</constant>
        <linear>0.1</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_collision">
          <pose>1.5 0 0.15 0 0 0</pose>
          <geometry><box><size>0.05 3.05 0.3</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>1.5 0 0.15 0 0 0</pose>
          <geometry><box><size>0.05 3.05 0.3</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
        <collision name="south_collision">
          <pose>-1.5 0 0.15 0 0 0</pose>
          <geometry><box><size>0.05 3.05 0.3</size></box></geometry>
        </collision>
        <visual name="south_visual">
          <pose>-1.5 0 0.15 0 0 0</pose>
          <geometry><box><size>0.05 3.05 0.3</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
        <collision name="east_collision">
          <pose>0 -1.5 0.15 0 0 0</pose>
          <geometry><box><size>3.05 0.05 0.3</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>0 -1.5 0.15 0 0 0</pose>
          <geometry><box><size>3.05 0.05 0.3</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
        <collision name="west_collision">
          <pose>0 1.5 0.15 0 0 0</pose>
          <geometry><box><size>3.05 0.05 0.3</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>0 1.5 0.15 0 0 0</pose>
          <geometry><box><size>3.05 0.05 0.3</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_box">
      <static>true</static>
      <pose>1.0 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_cylinder">
      <static>true</static>
      <pose>-0.6 0.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.1 0.25 0.8 1</ambient><diffuse>0.1 0.25 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="yellow_box">
      <static>true</static>
      <pose>0.4 -0.9 0.075 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.3 0.15</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.3 0.15</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
