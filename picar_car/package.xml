<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>picar_car</name>
  <version>0.1.0</version>
  <description>The real PiCar-B: the distance sensor node, and car.launch.py, which starts the camera, the distance sensor and picar_base</description>
  <maintainer email="todo@example.com">ferin</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>picar_base</exec_depend>
  <exec_depend>camera_ros</exec_depend>
  <exec_depend>python3-gpiozero</exec_depend>
  <exec_depend>python3-lgpio</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
